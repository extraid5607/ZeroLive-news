# ===============================================
# Kotak Neo API Configuration
# ===============================================

# Host and Port for the local terminal web server
HOST=127.0.0.1
PORT=8000

# Kotak Neo Trade API Credentials
# (Obtain Consumer Key & Secret from Kotak Neo Web/App -> Invest -> Trade API)
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=

# User Login Credentials
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_MPIN=

# Optional: TOTP Secret (Base32 secret key from Kotak TOTP setup)
# If provided, the terminal will automatically generate the 6-digit TOTP code
KOTAK_TOTP_SECRET=

# Environment: 'prod' for Live Trading, 'uat' for sandbox
KOTAK_ENVIRONMENT=prod

# Simulation / Mock Mode (set to 'true' for paper trading without Kotak login)
SIMULATION_MODE=true

# ===============================================
# Telegram Breaking News Alerts
# ===============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
